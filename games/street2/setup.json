{
  "game": "FIFA Street 2",
  "disc": "original Xbox, USA",
  "play": "Play-FIFA-Street-2.cmd",
  "disk_gb": 8,
  "download_gb": 1,
  "minutes": "20-60",
  "tools": [
    "llvm",
    "cmake",
    "ninja"
  ],
  "gb_per_job": 2,
  "requirements": "requirements.txt",
  "steps": [
    {
      "name": "Translate the game code and compile",
      "run": [
        "{python}",
        "tools/build_local.py",
        "--game-files",
        "{game_files}",
        "--llvm-dir",
        "{llvm}",
        "--jobs",
        "{jobs}"
      ],
      "reuse_if": ".local/generation-complete.json",
      "reuse_arg": "--reuse-generated",
      "retry_if": ".local/build/build.ninja"
    }
  ],
  "submodules": {
    "../../tools/port-installer": {
      "url": "https://github.com/batatinhafcbatatinha-pixel/port-installer.git",
      "commit": "7c3b4ad5d353cf4609d1c00ab96168a3d16e084f"
    }
  },
  "linux": {
    "play": "Play.sh",
    "exe": ".local/build/fifastreet_recomp",
    "tools": [
      "llvm",
      "cmake",
      "ninja"
    ],
    "buildtools": false,
    "steps": [
      {
        "name": "Prepare and build the native profile",
        "run": [
          "bash",
          "build-linux.sh",
          "--jobs",
          "{jobs}"
        ],
        "retry_if": ".local/build/build.ninja"
      }
    ]
  },
  "macos": {
    "play": "Play.sh",
    "exe": ".local/build/fifastreet_recomp",
    "tools": [
      "llvm",
      "cmake",
      "ninja"
    ],
    "buildtools": false,
    "steps": [
      {
        "name": "Prepare and build the native profile",
        "run": [
          "bash",
          "build-macos.sh",
          "--jobs",
          "{jobs}"
        ],
        "retry_if": ".local/build/build.ninja"
      }
    ]
  }
}
