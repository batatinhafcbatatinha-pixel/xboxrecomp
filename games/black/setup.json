{
  "game": "Black",
  "disc": "original Xbox, USA",
  "play": "Play-Black.cmd",
  "disk_gb": 10,
  "download_gb": 1,
  "minutes": "30-90",
  "tools": [
    "llvm",
    "cmake",
    "ninja"
  ],
  "gb_per_job": 2,
  "requirements": "requirements.txt",
  "steps": [
    {
      "name": "Copy your executable",
      "done_if": "default.xbe",
      "prepare": true,
      "run": [
        "{python}",
        "-c",
        "import shutil; shutil.copy2('game_files/default.xbe', 'default.xbe')"
      ]
    },
    {
      "name": "Translate the game code",
      "run": [
        "{python}",
        "scripts/native_pipeline.py",
        "generate"
      ],
      "done_if": "project/src/recomp/gen/recomp_funcs.h",
      "prepare": true
    },
    {
      "name": "Compile",
      "run": [
        "{python}",
        "scripts/native_pipeline.py",
        "build"
      ],
      "env": {
        "BLACK_BUILD_JOBS": "{jobs}"
      },
      "retry_if": "project/out/build.ninja"
    }
  ],
  "submodules": {
    "../../tools/port-installer": {
      "url": "https://github.com/batatinhafcbatatinha-pixel/port-installer.git",
      "commit": "7c3b4ad5d353cf4609d1c00ab96168a3d16e084f"
    }
  },
  "linux": {
    "play": "Play.sh",
    "exe": "project/out-linux/black_native",
    "tools": [
      "llvm",
      "cmake",
      "ninja"
    ],
    "buildtools": false,
    "steps": [
      {
        "name": "Prepare and build the native profile",
        "run": [
          "bash",
          "build-linux.sh",
          "--jobs",
          "{jobs}"
        ],
        "retry_if": "project/out-linux/build.ninja"
      }
    ]
  },
  "macos": {
    "play": "Play.sh",
    "exe": "project/out-linux/black_native",
    "tools": [
      "llvm",
      "cmake",
      "ninja"
    ],
    "buildtools": false,
    "steps": [
      {
        "name": "Prepare and build the native profile",
        "run": [
          "bash",
          "build-macos.sh",
          "--jobs",
          "{jobs}"
        ],
        "retry_if": "project/out-linux/build.ninja"
      }
    ]
  }
}
