{
  "recomp": "xboxrecomp",
  "repo": "batatinhafcbatatinha-pixel/xboxrecomp",
  "branch": "ports",
  "games_dir": "games",
  "setup": "tools/port-installer/setup/setup.ps1",
  "tools_dir": ".local/tools",
  "deps": {
    "buildtools_gb": 7,
    "python_gb": 0.1,
    "tools": [
      {
        "id": "llvm",
        "name": "LLVM / Clang 22.1.2",
        "check": ".local/tools/llvm-22.1.2/bin/clang++.exe",
        "gb": 3.0
      },
      {
        "id": "cmake",
        "name": "CMake 3.31.12",
        "check": ".local/tools/cmake-3.31.12/bin/cmake.exe",
        "gb": 0.1
      },
      {
        "id": "ninja",
        "name": "Ninja 1.13.2",
        "check": ".local/tools/ninja-1.13.2/ninja.exe",
        "gb": 0.01
      }
    ]
  },
  "groups": [],
  "generic": {
    "play": "Play.cmd",
    "play_cmd": "@echo off\r\nrem Starts this game (built by the launcher with tools/xboxport).\r\npython \"%~dp0..\\..\\..\\tools\\xboxport\\xboxport.py\" play --port \"%~dp0.\"\r\nexit /b %errorlevel%\r\n",
    "exe": "build/out/bin/game.exe",
    "disk_gb": 10,
    "download_gb": 1,
    "minutes": "30-90",
    "tools": [
      "llvm-mingw",
      "cmake",
      "ninja"
    ],
    "gb_per_job": 2,
    "requirements": "../../../tools/xboxport/requirements.txt",
    "steps": [
      {
        "name": "Analyse and translate your game (xboxrecomp)",
        "run": [
          "{python}",
          "../../../tools/xboxport/xboxport.py",
          "prepare",
          "--port",
          "{root}"
        ],
        "done_if": "project/src/recomp/gen/recomp_funcs.h",
        "prepare": true
      },
      {
        "name": "Compile",
        "run": [
          "{python}",
          "../../../tools/xboxport/xboxport.py",
          "compile",
          "--port",
          "{root}",
          "--jobs",
          "{jobs}"
        ],
        "retry_if": "build/out/build.ninja"
      }
    ],
    "buildtools": false,
    "settings": {
      "ini": "pc-settings.ini",
      "section": "video",
      "pc_menu": false,
      "groups": [
        {
          "pt": "Vídeo",
          "en": "Video",
          "items": [
            {
              "key": "filter",
              "pt": "Ampliação da imagem",
              "en": "Picture scaling",
              "default": 2,
              "restart": true,
              "help_pt": "AMD FSR 1.0 amplia a imagem até a janela reconstruindo as bordas.",
              "help_en": "AMD FSR 1.0 enlarges the picture to the window rebuilding its edges.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Suave (bilinear)",
                  "en": "Smooth (bilinear)",
                  "word": "linear"
                },
                {
                  "v": 1,
                  "pt": "Pixels nítidos",
                  "en": "Sharp pixels",
                  "word": "point"
                },
                {
                  "v": 2,
                  "pt": "AMD FSR 1.0",
                  "en": "AMD FSR 1.0",
                  "word": "fsr"
                },
                {
                  "v": 3,
                  "pt": "NVIDIA DLSS (com API Vulkan; placas RTX)",
                  "en": "NVIDIA DLSS (with the Vulkan API; RTX cards)",
                  "word": "dlss"
                }
              ]
            },
            {
              "key": "vsync",
              "pt": "Sincronia vertical (vsync)",
              "en": "Vertical sync (vsync)",
              "default": 1,
              "restart": true,
              "choices": [
                {
                  "v": 0,
                  "pt": "Desligado",
                  "en": "Off"
                },
                {
                  "v": 1,
                  "pt": "Ligado",
                  "en": "On"
                }
              ]
            },
            {
              "key": "aspect",
              "pt": "Proporção",
              "en": "Aspect",
              "default": 0,
              "restart": true,
              "help_pt": "Esticar preenche telas ultrawide.",
              "help_en": "Stretching fills ultrawide screens.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Manter a do jogo",
                  "en": "Keep the game's",
                  "word": "keep"
                },
                {
                  "v": 1,
                  "pt": "Esticar na janela",
                  "en": "Stretch to the window",
                  "word": "stretch"
                }
              ]
            },
            {
              "key": "widescreen",
              "pt": "TV widescreen (16:9)",
              "en": "Widescreen TV (16:9)",
              "default": 1,
              "restart": true,
              "help_pt": "Jogos com modo widescreen passam a desenhar em 16:9.",
              "help_en": "Games with a widescreen mode then draw in 16:9.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Desligado",
                  "en": "Off"
                },
                {
                  "v": 1,
                  "pt": "Ligado",
                  "en": "On"
                }
              ]
            },
            {
              "key": "progressive",
              "pt": "TV com 480p",
              "en": "480p TV",
              "default": 1,
              "restart": true,
              "choices": [
                {
                  "v": 0,
                  "pt": "Desligado",
                  "en": "Off"
                },
                {
                  "v": 1,
                  "pt": "Ligado",
                  "en": "On"
                }
              ]
            },
            {
              "key": "antialiasing",
              "pt": "Antisserrilhado",
              "en": "Anti-aliasing",
              "default": 0,
              "restart": true,
              "help_pt": "FXAA suaviza bordas serrilhadas; não se soma ao FSR.",
              "help_en": "FXAA smooths jagged edges; it does not combine with FSR.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Desligado",
                  "en": "Off",
                  "word": "off"
                },
                {
                  "v": 1,
                  "pt": "FXAA",
                  "en": "FXAA",
                  "word": "fxaa"
                }
              ]
            },
            {
              "key": "gpu",
              "pt": "Placa de vídeo",
              "en": "Graphics card",
              "default": -1,
              "restart": true,
              "source": "gpus",
              "help_pt": "Em notebooks com duas, escolha a dedicada.",
              "help_en": "On laptops with two, pick the dedicated one."
            },
            {
              "key": "api",
              "pt": "API gráfica",
              "en": "Graphics API",
              "default": 0,
              "restart": true,
              "help_pt": "Vulkan: a janela do jogo é apresentada em Vulkan (com FSR ou DLSS) e o Direct3D 11 roda sobre Vulkan (DXVK). Sem placa com Vulkan, fica o Direct3D 11.",
              "help_en": "Vulkan: the game's window is presented through Vulkan (with FSR or DLSS) and Direct3D 11 runs on Vulkan (DXVK). Without a Vulkan card, Direct3D 11 stays.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Direct3D 11 (nativa)",
                  "en": "Direct3D 11 (native)",
                  "word": "native"
                },
                {
                  "v": 1,
                  "pt": "Vulkan",
                  "en": "Vulkan",
                  "word": "vulkan"
                }
              ]
            },
            {
              "key": "dlss5",
              "pt": "DLSS 5 (Neural Rendering)",
              "en": "DLSS 5 (Neural Rendering)",
              "default": 0,
              "restart": true,
              "help_pt": "Precisa do nvngx_dlssnr.dll que você mesmo colocar ao lado do jogo (a NVIDIA não publica; roda em RTX 50) e da API Vulkan. Sem ele, nada muda.",
              "help_en": "Needs nvngx_dlssnr.dll that you put next to the game yourself (NVIDIA does not publish it; runs on RTX 50) and the Vulkan API. Without it, nothing changes.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Desligado",
                  "en": "Off"
                },
                {
                  "v": 1,
                  "pt": "Ligado",
                  "en": "On"
                }
              ]
            },
            {
              "key": "dlss5_strength",
              "pt": "Força do DLSS 5",
              "en": "DLSS 5 strength",
              "default": 50,
              "min": 0,
              "max": 100,
              "step": 5,
              "restart": true
            },
            {
              "key": "dlss5_style",
              "pt": "Estilo do DLSS 5",
              "en": "DLSS 5 style",
              "default": 0,
              "restart": true,
              "choices": [
                {
                  "v": 0,
                  "pt": "Padrão",
                  "en": "Default",
                  "word": "default"
                },
                {
                  "v": 1,
                  "pt": "Natural",
                  "en": "Natural",
                  "word": "natural"
                },
                {
                  "v": 2,
                  "pt": "Cinematográfico",
                  "en": "Cinematic",
                  "word": "cinematic"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "generic_label": "^[0-9A-F]{8}$"
}
